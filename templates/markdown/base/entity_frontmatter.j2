{#- YAML frontmatter for Obsidian properties.

    Fixed fields that are None (common for REntity, which has no
    groupname/source/inside/order/level/line) are OMITTED rather than
    emitted as the literal string "None", which Obsidian rejects as an
    invalid property.

    `description` is emitted once (line 4); it is excluded from the
    get_element_names() loop to avoid a duplicate key (REntity exposes
    `description` as one of its elements).

    For a Person (occurrence): emits `real_person_ids`.
    For an REntity (real entity): emits `occurrences`. -#}
---
id: "{{ model.id }}"
description: "{{ model.get_description() | replace('"', '\\"') }}"
{%- if model.groupname is not none %}
group_name: "{{ model.groupname }}"
{%- endif %}
class: "{{ model.pom_class }}"
{%- if model.the_source is not none %}
source: "[[{{ model.the_source }}]]"
{%- endif %}
{%- if model.inside is not none %}
inside: "[[{{ model.inside }}]]"
{%- endif %}
{%- if model.the_order is not none %}
order: {{ model.the_order }}
{%- endif %}
{%- if model.the_level is not none %}
level: {{ model.the_level }}
{%- endif %}
{%- if model.the_line is not none %}
line: {{ model.the_line }}
{%- endif %}
{%- if model.updated %}
updated: "{{ model.updated.strftime('%Y-%m-%dT%H:%M:%S') }}"
{%- endif %}
{%- if model.indexed is not none %}
indexed: {{ model.indexed | string | lower }}
{%- endif %}
{%- for element in model.get_element_names() if element not in ["class", "id", "obs", "description", "the_class"] %}
{{ element }}: "{{ model.for_kleio(element) | replace('"', '\\"') }}"
{%- endfor %}
{%- if model.pom_class == 'rentity' %}
occurrences:
{%- for l in model.links %}
  - "{{ l.entity }}"
{%- endfor %}
{%- elif model.links %}
real_person_ids:
{%- for l in model.links %}
  - "{{ l.rid }}"
{%- endfor %}
{%- endif %}
---

